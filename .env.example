# Copy these into your host's "Environment variables" screen (or a .env file used by Docker).
PORT=8765
SHOP_TRUST_PROXY=1
SHOP_PUBLIC_URL=https://shop.yourdomain.com
# Where the SQLite database + backups live. Put it OUTSIDE the code folder and back it up.
SHOP_DATA_DIR=/var/lib/shop-desk
# Optional: choose the first-run setup code yourself (16+ chars). Delete it after creating the owner.
SHOP_SETUP_CODE=
# Optional Gmail recovery
SHOP_GMAIL_USER=
SHOP_GMAIL_APP_PASSWORD=
