# Copy these into your host's "Environment variables" screen (or a .env file used by Docker).
PORT=8765
# Bind address. PORT is enough for normal installs; set explicitly if needed.
# SHOP_HOST=0.0.0.0
SHOP_TRUST_PROXY=1
SHOP_PUBLIC_URL=https://shop.yourdomain.com
# Where the SQLite database + backups live. Put it OUTSIDE the code folder and back it up.
SHOP_DATA_DIR=/var/lib/shop-desk
# Optional: choose the first-run setup code yourself (16+ chars). Delete it after creating the owner.
SHOP_SETUP_CODE=

# ---- Google Drive offsite backups (optional but strongly recommended) ----
# Create an OAuth client in Google Cloud Console (type: Web application) and add
# this exact redirect URI: http://localhost:8765/api/backups/offsite/oauth/callback
# For hosted installs use: https://your-domain/api/backups/offsite/oauth/callback
SHOP_GOOGLE_CLIENT_ID=
SHOP_GOOGLE_CLIENT_SECRET=
# If the redirect URI should differ from the default (see DEPLOY.md):
# SHOP_OAUTH_REDIRECT=https://your-domain/api/backups/offsite/oauth/callback
# Backups are encrypted with this key. If empty, one is generated in DATA_DIR/offsite.key.
# Set it once and keep a copy: losing it makes old offsite backups unreadable.
SHOP_BACKUP_KEY=

# ---- Licence signing (vendor machine only - never put the private key on a shop PC) ----
# SHOP_LICENSE_PRIVATE_KEY=/path/to/vendor/license-private-key.pem

# ---- Optional Gmail recovery ----
SHOP_GMAIL_USER=
SHOP_GMAIL_APP_PASSWORD=

# ---- Signed update notices (optional) ----
# Public HTTPS URL of the signed release manifest. Leave empty to hide update checks.
# Create it with: npm run release:manifest -- --version 12.0.1 --url https://…/ShopDesk-12.0.1.zip
SHOP_UPDATE_MANIFEST_URL=
# Testing only: allow a loopback http:// manifest. Never use in production.
# SHOP_UPDATE_ALLOW_HTTP=1

# ---- Testing hooks (self-hosted automated tests only) ----
# Override the Google endpoints to point at a fake Drive server.
# SHOP_GOOGLE_AUTH_URL=
# SHOP_GOOGLE_TOKEN_URL=
# SHOP_GOOGLE_FILES_URL=
# SHOP_GOOGLE_UPLOAD_URL=
